set(EGAUGE_UI_PROFILE_SOURCE "${CMAKE_CURRENT_LIST_DIR}/../main/src/gauge_presentation_reference.c"
    CACHE FILEPATH "Immutable presentation provider for this firmware target")
if(NOT IS_ABSOLUTE "${EGAUGE_UI_PROFILE_SOURCE}" OR NOT EXISTS "${EGAUGE_UI_PROFILE_SOURCE}")
    message(FATAL_ERROR "EGAUGE_UI_PROFILE_SOURCE must name an existing absolute source path")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../assets/fonts/sources.cmake")
set(EGAUGE_UI_FONT_SOURCES "" CACHE STRING "Optional complete native font source list")
if(EGAUGE_UI_FONT_SOURCES)
    set(FONT_SOURCES ${EGAUGE_UI_FONT_SOURCES})
    foreach(source IN LISTS FONT_SOURCES)
        if(NOT IS_ABSOLUTE "${source}" OR NOT EXISTS "${source}")
            message(FATAL_ERROR "EGAUGE_UI_FONT_SOURCES entries must be existing absolute source paths")
        endif()
    endforeach()
endif()
