  "claims": {
    "CORE": {
      "scope": "development",
      "sources": [
        "docs/features.md",
        "docs/architecture/vehicle-connections.md"
      ],
      "evidence": [
        "docs/evidence/gatt-long-read-recovery.md"
      ],
      "text": "Your own pages, readings and alerts on a small display that runs on its own once configured. Thoughtful software, on hardware you buy independently."
    },
    "LAYOUTS": {
      "scope": "development",
      "sources": [
        "docs/architecture/display-experience.md",
        "contracts/reading-catalog.json"
      ],
      "evidence": [
        "docs/evidence/display-evolution.md"
      ],
      "text": "Numeric, Arc, Bar, Trend, Dual, or Dual + arc. Arrange pages and save your display settings. Optional Smart cycling uses reading context and alert priorities while giving every saved page time on screen."
    },
    "ANDROID": {
      "scope": "development",
      "sources": [
        "docs/architecture/android-runtime.md",
        "docs/architecture/interaction-recovery.md",
        "docs/protocol/wifi-bulk-v1.md"
      ],
      "evidence": [
        "docs/evidence/dev75-indoor-rollout.md"
      ],
      "text": "The Android App manages vehicles, gauges, pages, and alerts. It reconnects and reads saved settings automatically, and installs signed development firmware over private Wi-Fi."
    },
    "READINGS": {
      "scope": "observed",
      "sources": [
        "docs/architecture/vehicle-connections.md"
      ],
      "evidence": [
        "docs/evidence/gatt-long-read-recovery.md"
      ],
      "text": "Live engine RPM has matched the Jeep's dash. Transmission temperature and gear display on the gauge. Simultaneous ECM and TCM readings, independent adapter loss and return, and operation without the phone have been checked on this setup."
    },
    "UPDATES": {
      "scope": "observed",
      "sources": [
        "docs/architecture/platforms-and-releases.md"
      ],
      "evidence": [
        "docs/evidence/dev75-indoor-rollout.md",
        "docs/evidence/action-pages-indoor.md"
      ],
      "text": "Saved configuration and signed App/Wi-Fi firmware installation are working. Repeated Wi-Fi sessions and controlled interrupted-update checks have passed with saved setup retained. Longer loaded tests and physical power-loss cases remain."
    },
    "PLATFORMS": {
      "scope": "planned",
      "sources": [
        "docs/roadmap.md"
      ],
      "evidence": [
        "docs/backlog.md"
      ],
      "text": "A basic iPhone App and browser-over-USB setup are planned. Core configuration should be available without relying on an Android phone; neither path is available today."
    },
    "ROAD_ALERTS": {
      "scope": "exploring",
      "sources": [
        "docs/roadmap.md",
        "docs/architecture/phone-alert-providers.md"
      ],
      "evidence": [
        "docs/backlog.md"
      ],
      "text": "Road-aware alerts are being explored. They are not available in the current build; provider access and real-world relevance still need validation."
    },
    "BUILD_STORY": {
      "scope": "observed",
      "sources": [
        "docs/architecture/vehicle-connections.md"
      ],
      "evidence": [
        "docs/evidence/gatt-long-read-recovery.md"
      ],
      "text": "Built by Luke around a real Hemi-swapped Wrangler: keep engine and transmission readings together, save the setup on the gauge, and leave the phone in your pocket. Independent adapter loss and return have been checked on that Jeep. Broader vehicle and loaded-operation testing come next."
    },
    "ACTIONS": {
      "scope": "candidate",
      "sources": [
        "docs/architecture/vehicle-actions.md"
      ],
      "evidence": [
        "docs/evidence/jeep-high-idle-reference.md",
        "docs/evidence/dev80-action-entry.md"
      ],
      "text": "Give useful routines a place on your dash. Air up and Winch pair a saved idle preset with a clear countdown and direct Stop. Being tested on Luke’s 5.7L Hemi-swapped Wrangler."
    }
  },
